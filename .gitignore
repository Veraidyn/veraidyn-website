# =====================================================================
# This repo is PUBLIC. Only what a visitor's browser needs may be
# committed. Everything else stays on local disk.
#
# What ships (7 files):
#   index.html
#   vercel.json
#   logo-nav.png  logo-hero.png  favicon.png  apple-touch-icon.png  og.png
#
# Before adding anything, ask: does a visitor's browser load this?
# If not, it belongs below.
# =====================================================================

# --- Background material. Never publish. -----------------------------
# Strategy, positioning, IP boundaries and design rationale all live in
# markdown. None of it serves the page and some of it is commercially
# sensitive.
*.md

# Source documents. A stray pitch deck or whitepaper in a public repo
# is the worst-case disclosure, so block the formats outright.
*.pptx
*.potx
*.docx
*.dotx
*.pdf
*.key
*.numbers
*.xlsx

# --- Design explorations and prototypes ------------------------------
# Useful history, but they expose rejected directions and internal
# review notes. Keep them local.
hero-*.html
approach-*.html
gap3-options.html
cta-map.html
cta-mesh.html
answer-*.html
combined-mockups.html

# --- Build and review artefacts --------------------------------------
# Point-in-time snapshot of index.html plus its generator. The snapshot
# would go stale against the real page and must never be served.
veraidyn-review.html
make-review.py

# Generated whitepaper PDFs ARE published assets and must ship, so they are
# re-admitted here despite the blanket *.pdf rule above. Everything else in
# PDF form is still treated as a source document and stays out.
!assets/papers/
!assets/papers/*.pdf

# Unused source artwork. The page never loads it.
logo.png

# --- Video -----------------------------------------------------------
# Masters and working files stay local. Only the encoded deliverable in
# assets/video/ is served, and it is copied there deliberately rather
# than committed from the editing folder.
#
# This matters more than for other assets: a binary committed to a
# public repo is permanent and recoverable from history even after it is
# deleted, and a 27MB master re-committed on each revision compounds
# that. Encode locally, check it, then publish one copy.
assets/Demos/
*.mov
*.MOV
*.avi
*.mkv
*.webm.part

# --- Tooling and local config ----------------------------------------
.claude/
.vercel/
.env
.env.*
node_modules/
.venv/
__pycache__/

# --- OS and editor cruft ---------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
